<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <org.osmdroid.views.MapView
            android:id="@+id/map"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:contentDescription="Position du portail"
            android:src="@drawable/ic_crosshair" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_margin="12dp"
            android:background="#CC000000"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="Déplacez la carte pour placer le viseur sur le portail"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnMyPosition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:contentDescription="Ma position"
            android:src="@drawable/ic_my_location" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtCoords"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <TextView
            android:id="@+id/txtRadius"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:drawablePadding="6dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="#1F6FEB" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderRadius"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="Rayon de la zone du portail"
            android:stepSize="10"
            android:value="200"
            android:valueFrom="50"
            android:valueTo="1000" />

        <TextView
            android:id="@+id/txtApproach"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="#E8710A" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderApproach"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="Rayon de la zone d'approche"
            android:stepSize="100"
            android:value="2000"
            android:valueFrom="500"
            android:valueTo="5000" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="Annuler" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnValidate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Valider" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
