<resources>
    <style name="Theme.PortailAuto" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_onPrimaryContainer</item>
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_onSecondaryContainer</item>
        <item name="colorTertiary">@color/md_tertiary</item>
        <item name="colorOnTertiary">@color/md_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_onTertiaryContainer</item>
        <item name="android:colorBackground">@color/md_background</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_onSurfaceVariant</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorSurfaceContainerLow">@color/md_surfaceContainerLow</item>
        <item name="colorSurfaceContainer">@color/md_surfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/md_surfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/md_surfaceContainerHighest</item>
        <item name="materialCardViewStyle">@style/Widget.Material3.CardView.Filled</item>
        <!-- Charte : police Be Vietnam Pro partout (CHARTE.md) -->
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="fontFamily">@font/be_vietnam_pro</item>
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.PortailKeo.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.PortailKeo.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.PortailKeo.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.PortailKeo.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.PortailKeo.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.PortailKeo.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.PortailKeo.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.PortailKeo.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.PortailKeo.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.PortailKeo.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.PortailKeo.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.PortailKeo.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.PortailKeo.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.PortailKeo.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.PortailKeo.LabelSmall</item>
    </style>

    <!-- Niveaux de texte de la charte : ceux de Material 3, en Be Vietnam Pro -->
    <style name="TextAppearance.PortailKeo.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textFontWeight">400</item>
    </style>
    <style name="TextAppearance.PortailKeo.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textFontWeight">400</item>
    </style>
    <style name="TextAppearance.PortailKeo.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textFontWeight">600</item>
    </style>
    <style name="TextAppearance.PortailKeo.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textFontWeight">600</item>
    </style>
    <style name="TextAppearance.PortailKeo.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textFontWeight">700</item>
    </style>
    <style name="TextAppearance.PortailKeo.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textFontWeight">600</item>
    </style>
    <style name="TextAppearance.PortailKeo.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textFontWeight">600</item>
    </style>
    <style name="TextAppearance.PortailKeo.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textFontWeight">600</item>
    </style>
    <style name="TextAppearance.PortailKeo.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textFontWeight">500</item>
    </style>
    <style name="TextAppearance.PortailKeo.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textFontWeight">400</item>
    </style>
    <style name="TextAppearance.PortailKeo.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textFontWeight">400</item>
    </style>
    <style name="TextAppearance.PortailKeo.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textFontWeight">400</item>
    </style>
    <style name="TextAppearance.PortailKeo.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textFontWeight">600</item>
    </style>
    <style name="TextAppearance.PortailKeo.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textFontWeight">500</item>
    </style>
    <style name="TextAppearance.PortailKeo.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textFontWeight">500</item>
    </style>


    <!-- Carte de section de l'écran principal -->
    <style name="SectionCard" parent="Widget.Material3.CardView.Filled">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="contentPadding">16dp</item>
    </style>
    <style name="SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:drawableTint">?attr/colorPrimary</item>
    </style>
    <style name="SectionHint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodySmall</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="SetupPage">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:visibility">gone</item>
    </style>
    <style name="SetupText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
    </style>
    <!-- Titre de page (Accueil, Réglages, Historique) -->
    <style name="PageTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">20dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:textAppearance">?attr/textAppearanceHeadlineMedium</item>
    </style>
    <!-- Groupe d'entrées de l'onglet Réglages -->
    <style name="SettingsGroup" parent="Widget.Material3.CardView.Filled">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
    </style>
    <style name="SettingsLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>
    <!-- Étape du suivi d'appel (Arrivée, Appel, Raccrochage) -->
    <style name="LiveStep">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">4dp</item>
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">6dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
    </style>
</resources>
