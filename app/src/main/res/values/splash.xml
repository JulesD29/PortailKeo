<?xml version="1.0" encoding="utf-8"?>
<!--
  Écran de démarrage d'Android : le pilier du K (splash_icon_closed) sur le vert portail, première image de la vidéo
  d'ouverture (res/raw/ouverture.mp4) que MainActivity joue ensuite. Identique dans la version de test.
-->
<resources>
    <color name="splash_bg">#0B3722</color>
    <color name="splash_post">#FFFFFF</color>

    <style name="Theme.PortailAuto.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_closed</item>
        <item name="postSplashScreenTheme">@style/Theme.PortailAuto</item>
    </style>
</resources>
