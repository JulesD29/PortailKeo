<?xml version="1.0" encoding="utf-8"?>
<!--
  Animation de démarrage, mêmes temps que la maquette (boucle de 4 s, ici jouée une fois) :
  0–480 ms     l'icône grossit légèrement (90 % → 100 %)
  720–1680 ms  les deux battants s'ouvrent en perspective
  1200–2000 ms le chemin s'éclaire et s'allonge ; le halo rose apparaît puis s'adoucit
  Le nom, la phrase (1760 ms) et le fondu vers l'accueil (2960 ms) sont joués par MainActivity (Splash).
  Grille de 108 affichée en 288 dp, comme l'icône de l'écran de démarrage d'Android (splash_icon_closed).
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="288dp"
            android:height="288dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <group android:name="zoom" android:pivotX="54" android:pivotY="54" android:scaleX="0.9" android:scaleY="0.9">
                <group android:pivotX="54" android:pivotY="54" android:scaleX="0.9" android:scaleY="0.9">
                    <path android:name="glow" android:fillColor="@color/splash_leaf" android:fillAlpha="0"
                        android:pathData="M54,30 a34,34 0 1,0 0.01,0 Z" />
                    <group android:name="roadGroup" android:pivotX="54" android:pivotY="84" android:scaleY="0">
                        <path android:name="road" android:fillColor="@color/splash_path" android:fillAlpha="0"
                            android:pathData="M46,84 L62,84 L76,108 L32,108 Z" />
                    </group>
                    <path android:fillColor="@color/splash_post"
                        android:pathData="M24,36 Q24,34 26,34 L28,34 Q30,34 30,36 L30,82 Q30,84 28,84 L26,84 Q24,84 24,82 Z" />
                    <path android:fillColor="@color/splash_post"
                        android:pathData="M78,36 Q78,34 80,34 L82,34 Q84,34 84,36 L84,82 Q84,84 82,84 L80,84 Q78,84 78,82 Z" />
                    <path android:name="leafL" android:fillColor="@color/splash_leaf"
                        android:pathData="M30,42 L54,42 L54,82 L30,82 Z" />
                    <path android:name="leafR" android:fillColor="@color/splash_leaf"
                        android:pathData="M78,42 L54,42 L54,82 L78,82 Z" />
                </group>
            </group>
        </vector>
    </aapt:attr>

    <target android:name="zoom">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:valueType="floatType"
                    android:duration="480" android:valueFrom="0.9" android:valueTo="1"
                    android:interpolator="@android:interpolator/decelerate_quad" />
                <objectAnimator android:propertyName="scaleY" android:valueType="floatType"
                    android:duration="480" android:valueFrom="0.9" android:valueTo="1"
                    android:interpolator="@android:interpolator/decelerate_quad" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="leafL">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="pathData" android:valueType="pathType"
                android:startOffset="720" android:duration="960"
                android:valueFrom="M30,42 L54,42 L54,82 L30,82 Z"
                android:valueTo="M30,40 L46,46 L46,80 L30,82 Z">
                <aapt:attr name="android:interpolator">
                    <pathInterpolator android:controlX1="0.3" android:controlY1="0.7"
                        android:controlX2="0.2" android:controlY2="1" />
                </aapt:attr>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="leafR">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="pathData" android:valueType="pathType"
                android:startOffset="720" android:duration="960"
                android:valueFrom="M78,42 L54,42 L54,82 L78,82 Z"
                android:valueTo="M78,40 L62,46 L62,80 L78,82 Z">
                <aapt:attr name="android:interpolator">
                    <pathInterpolator android:controlX1="0.3" android:controlY1="0.7"
                        android:controlX2="0.2" android:controlY2="1" />
                </aapt:attr>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="roadGroup">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="scaleY" android:valueType="floatType"
                android:startOffset="1200" android:duration="800"
                android:valueFrom="0" android:valueTo="1"
                android:interpolator="@android:interpolator/decelerate_quad" />
        </aapt:attr>
    </target>
    <target android:name="road">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillAlpha" android:valueType="floatType"
                android:startOffset="1200" android:duration="800"
                android:valueFrom="0" android:valueTo="0.55"
                android:interpolator="@android:interpolator/decelerate_quad" />
        </aapt:attr>
    </target>
    <target android:name="glow">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator android:propertyName="fillAlpha" android:valueType="floatType"
                    android:startOffset="1200" android:duration="880"
                    android:valueFrom="0" android:valueTo="0.35"
                    android:interpolator="@android:interpolator/decelerate_quad" />
                <objectAnimator android:propertyName="fillAlpha" android:valueType="floatType"
                    android:duration="1920" android:valueFrom="0.35" android:valueTo="0.2" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
