<?xml version="1.0" encoding="utf-8"?>
<!--
  Animation de démarrage avec le logo « K d'un trait » (mêmes temps que la maquette, joués une fois) :
  0–480 ms     le logo grossit légèrement (90 % → 100 %)
  720–1680 ms  les deux battants, fermés l'un sur l'autre, s'ouvrent autour de leur charnière et forment le K
  1450–1850 ms le point rose apparaît : l'appel part
  Le nom, la phrase (1760 ms) et le fondu vers l'accueil (2960 ms) sont joués par MainActivity (Splash).
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="288dp" android:height="288dp"
            android:viewportWidth="108" android:viewportHeight="108">
            <group android:name="zoom" android:pivotX="54" android:pivotY="54" android:scaleX="0.9" android:scaleY="0.9">
                <group android:pivotX="54" android:pivotY="54" android:scaleX="0.9" android:scaleY="0.9">
                    <path android:strokeColor="@color/splash_post" android:strokeWidth="12" android:strokeLineCap="round"
                        android:pathData="M36,30 L36,78" />
                    <group android:name="leafTop" android:pivotX="53" android:pivotY="54">
                        <path android:strokeColor="@color/splash_leaf" android:strokeWidth="12" android:strokeLineCap="round"
                            android:pathData="M53,54 L78.5,54" />
                    </group>
                    <group android:name="leafBottom" android:pivotX="53" android:pivotY="54">
                        <path android:strokeColor="@color/splash_path" android:strokeWidth="12" android:strokeLineCap="round"
                            android:pathData="M53,54 L78.5,54" />
                    </group>
                    <group android:name="dot" android:pivotX="84" android:pivotY="54" android:scaleX="0" android:scaleY="0">
                        <path android:fillColor="@color/splash_leaf" android:pathData="M84,49 a5,5 0 1,0 0.01,0 Z" />
                    </group>
                </group>
            </group>
        </vector>
    </aapt:attr>

    <target android:name="zoom">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:valueType="floatType" android:duration="480"
                    android:valueFrom="0.9" android:valueTo="1" android:interpolator="@android:interpolator/decelerate_quad" />
                <objectAnimator android:propertyName="scaleY" android:valueType="floatType" android:duration="480"
                    android:valueFrom="0.9" android:valueTo="1" android:interpolator="@android:interpolator/decelerate_quad" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="leafTop">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="rotation" android:valueType="floatType"
                android:startOffset="720" android:duration="960" android:valueFrom="0" android:valueTo="-45">
                <aapt:attr name="android:interpolator">
                    <pathInterpolator android:controlX1="0.3" android:controlY1="0.7" android:controlX2="0.2" android:controlY2="1" />
                </aapt:attr>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="leafBottom">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="rotation" android:valueType="floatType"
                android:startOffset="720" android:duration="960" android:valueFrom="0" android:valueTo="45">
                <aapt:attr name="android:interpolator">
                    <pathInterpolator android:controlX1="0.3" android:controlY1="0.7" android:controlX2="0.2" android:controlY2="1" />
                </aapt:attr>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="dot">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:valueType="floatType" android:startOffset="1450"
                    android:duration="400" android:valueFrom="0" android:valueTo="1" android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator android:propertyName="scaleY" android:valueType="floatType" android:startOffset="1450"
                    android:duration="400" android:valueFrom="0" android:valueTo="1" android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
